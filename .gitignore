# Trailing slashes match directories only, and a SYMLINK to a directory is not a
# directory to git — a linked node_modules (worktrees, pnpm-style setups) slips
# straight past `node_modules/` and gets committed by `git add -A`. Match both.
node_modules
node_modules/

# Toolchain caches and agent worktrees. These lived only in .git/info/exclude,
# which is never cloned, so a fresh checkout that runs the toolchain had ~40GB
# untracked and unignored.
.gocache/
.gomodcache/
.gopath/
.npm-cache/
.worktrees/
.claude/
out/
dist/
coverage/
artifacts/
test-runtime/

# Electron Forge/Vite build output.
frontend/.vite/

# Platform-specific binaries and runtime bundles regenerated by frontend build
# scripts (build:daemon, browser-runtime:prepare, and build:acp-runtime).
frontend/daemon/
frontend/agent-browser/
frontend/resources/acp-runtime/

*.sqlite*
*.log
.DS_Store
